---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);

// Lucide outline icons, 16px grid (same family the desktop client uses).
const icons: string[] = [
  '<path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>',
  '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  '<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>',
  '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>',
  '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
];
---
<section class="section" id="capabilities">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{d.capabilities.eyebrow}</p>
      <h2>{d.capabilities.title}</h2>
    </div>
    <div class="grid-3">
      {d.capabilities.items.map((c, i) => (
        <article class="card">
          <div class="card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
          </div>
          <h3>{c.name}</h3>
          <p>{c.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
