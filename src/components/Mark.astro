  <rect x="106" y="106" width="88" height="88" />
  <rect x="212" y="106" width="88" height="88" />
  <rect x="318" y="106" width="88" height="88" />
  <rect x="106" y="212" width="88" height="88" />
  <rect x="212" y="212" width="88" height="88" />
  <rect x="106" y="318" width="88" height="88" />
</svg>
