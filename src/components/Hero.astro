---
import { t, href, type Locale } from '../i18n';
import poster from '../assets/shots/en/chat.png';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{d.hero.eyebrow}</p>
    <h1>{d.hero.title}</h1>
    <p class="lead">{d.hero.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={href(locale, '/download/')}>{d.hero.primary}</a>
      <a class="btn btn-secondary" href={href(locale, '/how-it-works/')}>{d.hero.secondary}</a>
    </div>
    <!-- The product reel: one sentence in, the AI builds the function, agent, trigger and workflow,
         runs it once and waits for approval. Recorded from the real app with a scripted model
         (see the Anselm repo, `make -C frontend demo AUTOPLAY=promo`). Muted autoplay is allowed
         everywhere; reduced-motion viewers keep the poster frame. -->
    <figure class="shot-stage">
      <video class="reel" autoplay muted loop playsinline preload="metadata" poster={poster.src} aria-label={d.hero.shotAlt} width="1280" height="772">
        <source src="/demo/anselm-reel.mp4" type="video/mp4" />
      </video>
    </figure>
    <script is:inline>
      (() => {
        const v = document.querySelector('.hero video.reel');
        if (!v) return;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        v.removeAttribute('autoplay');
        v.pause();
      })();
    </script>
  </div>
</section>
