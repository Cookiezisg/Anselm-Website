---
import Shot from './Shot.astro';
import { t, href, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{d.hero.eyebrow}</p>
    <h1>{d.hero.title}</h1>
    <p class="lead">{d.hero.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={href(locale, '/download/')}>{d.hero.primary}</a>
      <a class="btn btn-secondary" href={href(locale, '/how-it-works/')}>{d.hero.secondary}</a>
    </div>
    <Shot name="chat" locale={locale} alt={d.hero.shotAlt} loading="eager" priority />
  </div>
</section>
