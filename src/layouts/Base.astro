---
import '../styles/tokens.css';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  path: string; // locale-less path, e.g. '/' or '/download/'
  alternates?: boolean; // false for pages that exist in one locale only (404)
}

const { locale, path, alternates = true } = Astro.props;
const dict = t(locale);
const title = (Astro.props.title ?? dict.meta.title).replace(/[.。](?= — Anselm$)/, '');
const description = Astro.props.description ?? dict.meta.description;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://anselm.website';
const canonical = `${site}${locale === 'en' ? '' : '/zh'}${path}`;
const alternateEn = `${site}${path}`;
const alternateZh = `${site}/zh${path}`;
const htmlLang = locale === 'zh' ? 'zh-CN' : 'en';
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a remembered theme before first paint; without a stored choice the
      // page follows prefers-color-scheme through CSS alone.
      // 首帧前应用记住的主题;没有存储值时由 CSS 跟随系统偏好。
      try { const t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (_) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {alternates && <link rel="alternate" hreflang="zh-CN" href={alternateZh} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternateEn} />}
    {!alternates && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/brand/anselm-icon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anselm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Nav locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
