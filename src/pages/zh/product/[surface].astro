---
import Base from '../../../layouts/Base.astro';
import SurfacePage from '../../../components/SurfacePage.astro';
import { t } from '../../../i18n';

export function getStaticPaths() {
  return t('zh').surfaces.items.map((s) => ({ params: { surface: s.key } }));
}
const { surface } = Astro.params;
const d = t('zh');
const s = d.surfaces.items.find((i) => i.key === surface)!;
---
<Base locale="zh" path={`/product/${surface}/`} title={`${s.name} — Anselm`} description={s.lead}>
  <SurfacePage locale="zh" surface={surface!} />
</Base>
